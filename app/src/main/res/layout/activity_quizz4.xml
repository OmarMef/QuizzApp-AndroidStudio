<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Quizz4"
    android:background="@drawable/background_img"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="30dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="55dp"
            android:text="Question 4"
            android:textColor="@color/white"
            android:textSize="50dp" />


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/remington_gun"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="What type of shotguns this is ?"
            android:textSize="25dp"
            android:textColor="#FFFFFF"/>


        <Button
            android:id="@+id/BAnswer1"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="Mossberg 835"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />


        <Button
            android:id="@+id/BAnswer2"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="Remington 870"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />


        <Button
            android:id="@+id/BAnswer3"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="Browning A5 Magnum"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />








    </LinearLayout>



</LinearLayout>