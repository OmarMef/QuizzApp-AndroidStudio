<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Quizz3"
    android:background="@drawable/background_img">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="30dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingLeft="55dp"
            android:text="Question 3"
            android:textColor="@color/white"
            android:textSize="50dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/uzi_gun"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="How much can the Uzi shoot in a minute ?"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="25dp"/>

        <Button
            android:id="@+id/BAnswer1"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="500 shot/minute"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />

        <Button
            android:id="@+id/BAnswer2"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="900 shot/minute"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />

        <Button
            android:id="@+id/BAnswer3"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/custom_button"
            android:text="700 shot/minute"
            android:textAllCaps="false"
            android:textSize="17dp"
            android:textStyle="bold"
            />




    </LinearLayout>


</LinearLayout>